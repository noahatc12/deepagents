# ============================================================
# Apartment Lead Generation – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenCorporates API (optional) ---
# Increases rate limits on company search requests.
# Free tier available at https://opencorporates.com/
# OPENCORPORATES_API_KEY=your_key_here

# --- Socrata / Open Data Portal (optional) ---
# Provides higher rate limits for county assessor Socrata APIs.
# Get a free app token at https://dev.socrata.com/register
# SOCRATA_APP_TOKEN=your_token_here

# --- Logging ---
LOG_LEVEL=INFO
# LOG_FILE=logs/pipeline.log

# --- Cache ---
CACHE_DB_PATH=data/cache/requests.db
CACHE_TTL_SECONDS=86400

# --- Output ---
OUTPUT_DIR=data/processed

# --- CA SOS Bulk Data ---
# Download from:
# https://www.sos.ca.gov/business-programs/business-entities/data-file-request
# CA_SOS_CSV_PATH=data/ca_sos_entities.csv

# --- Optional LLM review (for unclear cases) ---
# Set OPENAI_API_KEY if you add an OpenAI-based LLM reviewer
# OPENAI_API_KEY=your_key_here
